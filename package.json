{
  "name": "opensky-computer-use",
  "version": "1.7.0-rc.3",
  "description": "Fast, local-first browser and desktop control for macOS agents, with on-device OCR, animated pointers, MCP, CLI and JavaScript. No built-in telemetry or cloud relay.",
  "type": "module",
  "main": "./src/index.mjs",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.mjs"
    },
    "./mcp": "./src/mcp-server.mjs"
  },
  "bin": {
    "opensky": "./src/cli.mjs",
    "opensky-mcp": "./src/mcp-server.mjs"
  },
  "scripts": {
    "build:native": "swift build -c release --package-path ./Native",
    "start": "node ./src/cli.mjs daemon",
    "demo": "node ./src/cli.mjs demo",
    "mcp": "node ./src/mcp-server.mjs",
    "test": "node --test test/*.test.mjs",
    "test:packaging": "node scripts/test-packaging.mjs",
    "test:live": "node test/live-fixture.mjs",
    "test:chrome": "node test/chrome-native-live.mjs",
    "test:browser": "node test/browser-live.mjs",
    "test:ui": "node test/native-ui-preview.mjs",
    "test:ui-service": "node test/native-ui-service.mjs",
    "build:app": "node scripts/build-app.mjs",
    "test:feedback": "node test/native-window-feedback.mjs",
    "test:inspector": "node test/inspector-live.mjs"
  },
  "keywords": [
    "computer-use",
    "codex",
    "sky",
    "macos",
    "accessibility",
    "mcp",
    "agent",
    "claude",
    "antigravity",
    "cursor-overlay"
  ],
  "os": [
    "darwin"
  ],
  "license": "MIT",
  "devDependencies": {
    "@modelcontextprotocol/sdk": "1.32.1"
  },
  "engines": {
    "node": ">=22"
  },
  "files": [
    "src",
    "assets",
    "Native/Package.swift",
    "Native/Sources",
    "scripts",
    "skills",
    "install.sh",
    "Install OpenSky.command",
    "README.md",
    "LICENSE",
    "test",
    "artifacts/2026-10-17-opensky-research-and-verification-Codex.txt",
