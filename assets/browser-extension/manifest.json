{
  "manifest_version": 3,
  "name": "OpenSky Browser",
  "version": "1.5.0",
  "description": "Local browser control for your AI agent: background task tabs, page controls and uploads through OpenSky.",
  "minimum_chrome_version": "125",
  "key": "",
  "permissions": ["debugger", "tabs", "storage", "alarms", "nativeMessaging"],
  "background": {"service_worker": "worker.mjs", "type": "module"},
  "action": {"default_title": "OpenSky Browser", "default_popup": "status.html"}
}
